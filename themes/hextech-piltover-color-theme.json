  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5C5B57",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#D4A017"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C89B3C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#D4A017"
      }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#4DA6FF"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "meta.parameter",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#F0E6D2"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "meta.number"
      ],
      "settings": {
        "foreground": "#D4A017"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.operator"
      ],
      "settings": {
        "foreground": "#CDBE91"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#CDBE91"
      }
    },
    {
      "name": "HTML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#C89B3C"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#4DA6FF"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#4DA6FF"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "support.type.property-value.css",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#D4A017"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#4DA6FF"
      }
    },
    {
      "name": "Language Specific - JavaScript/TypeScript",
      "scope": [
        "entity.name.type.class.jsdoc",
        "entity.name.type.interface.jsdoc"
      ],
      "settings": {
        "foreground": "#4DA6FF"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#C89B3C"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#D4A017"
      }
    },
    {
      "name": "Escape Sequences",
      "scope": [
        "constant.character.escape",
        "string.escape"
      ],
      "settings": {
        "foreground": "#D4A017"
      }
    },
    {
      "name": "Embedded Code",
      "scope": [
        "embedding",
        "source.embedded"
      ],
      "settings": {
        "foreground": "#A09B8C"
      }
    },
    {
      "name": "Invalid & Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F04747",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Meta Tags",
      "scope": [
        "meta.tag",
        "declaration.tag"
      ],
      "settings": {
        "foreground": "#C89B3C"
      }
    }
  ]
}
